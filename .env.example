APP_NAME="Hayat Travel Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Supplier GDS: stub | travelport | sabre | amadeus (see config/integrations.php + vendor configs)
SUPPLIER_GDS_DRIVER=stub
# INTEGRATIONS_DRIVER=stub
# test | production — selects credentials.*.test vs credentials.*.production
SUPPLIER_CREDENTIAL_ENV=production
# Refresh token when remaining lifetime <= this many seconds (default 300)
# SUPPLIER_TOKEN_REFRESH_BUFFER_SECONDS=300
# SUPPLIER_HTTP_TIMEOUT_SECONDS=30
# SUPPLIER_HTTP_CONNECT_TIMEOUT_SECONDS=10
# TEMP DEBUG ONLY (Duffel): set true only to isolate local SSL/certificate issues.
# DUFFEL_DEBUG_DISABLE_SSL_VERIFY=false
# Local/debug only: enables GET /test-duffel (minimal airlines list probe; requires APP_DEBUG or local env).
# DUFFEL_CONNECTIVITY_TEST_ENABLED=false
# Optional: read OAuth client_id/client_secret from integration_connections + integration_credentials
# INTEGRATIONS_USE_DATABASE_CREDENTIALS=false
# Mirror access tokens to integration_tokens (survives cache flush; requires a matching integration_connections row)
# INTEGRATIONS_PERSIST_TOKENS_TO_DATABASE=false
# TRAVELPORT_BASE_URL=
# TRAVELPORT_TOKEN_PATH=/oauth/token
# TRAVELPORT_TEST_CLIENT_ID=
# TRAVELPORT_TEST_CLIENT_SECRET=
# TRAVELPORT_PRODUCTION_CLIENT_ID=
# TRAVELPORT_PRODUCTION_CLIENT_SECRET=
# SABRE_BASE_URL=
# SABRE_TOKEN_PATH=/v2/auth/token
# SABRE_TEST_CLIENT_ID=
# SABRE_TEST_CLIENT_SECRET=
# SABRE_PRODUCTION_CLIENT_ID=
# SABRE_PRODUCTION_CLIENT_SECRET=
# AMADEUS_BASE_URL=
# AMADEUS_TOKEN_PATH=/v1/security/oauth2/token
# AMADEUS_TEST_API_KEY=
# AMADEUS_TEST_API_SECRET=
# AMADEUS_PRODUCTION_API_KEY=
# AMADEUS_PRODUCTION_API_SECRET=

# Normalized mapper versioning (optional overrides — see config/integration_mapping.php)
# INTEGRATION_SCHEMA_FLIGHT_OFFER=flight_offer.v1
# INTEGRATION_SCHEMA_PRICE_BREAKDOWN=price_breakdown.v1
# INTEGRATION_SCHEMA_BOOKING=booking.v1
# TRAVELPORT_API_FAMILY=air_v11
# TRAVELPORT_PROVIDER_VERSION=2026-01
# TRAVELPORT_MAPPER_VERSION=1.0.0

# Display FX: HTTP providers fill gaps when `exchange_rates` has no pair (on by default in production).
# Master off = DB/admin rates only (used in PHPUnit).
# DISPLAY_FX_HTTP_PROVIDERS_ENABLED=true
# FRANKFURTER_DISPLAY_FX_ENABLED=true
# FRANKFURTER_BASE_URL=https://api.frankfurter.app
# FRANKFURTER_TIMEOUT_SECONDS=5
# FRANKFURTER_CACHE_SECONDS=3600
# CURRENCY_API_DISPLAY_FX_ENABLED=true
# CURRENCY_API_BASE_URL=https://latest.currency-api.pages.dev/v1/currencies
# CURRENCY_API_TIMEOUT_SECONDS=8
# CURRENCY_API_CACHE_SECONDS=3600
# EXCHANGERATE_HOST_DISPLAY_FX_ENABLED=true
# EXCHANGERATE_HOST_BASE_URL=https://api.exchangerate.host
# EXCHANGERATE_HOST_TIMEOUT_SECONDS=8
# EXCHANGERATE_HOST_CACHE_SECONDS=3600
# Airport autocomplete fallback when local dataset misses (global coverage)
# AIRPORT_REMOTE_SEARCH_ENABLED=true
# AIRPORT_REMOTE_BASE_URL=https://raw.githubusercontent.com/mwgg/Airports/master/airports.json
# AIRPORT_REMOTE_TIMEOUT_SECONDS=10
# AIRPORT_REMOTE_CACHE_SECONDS=86400
# AIRPORT_GLOBAL_INDEX_CACHE_SECONDS=86400
# Markup on displayed converted amounts only (not supplier settlement): default 2%
# DISPLAY_CURRENCY_CONVERSION_FEE_PERCENT=2

# Payments: manual (default) | stripe — see config/payments.php and App\Services\Payment\PaymentService
PAYMENT_GATEWAY_DRIVER=manual
# STRIPE_SECRET=

# Communication Hub (Phase 14.1-14.4)
# COMM_EMAIL_PROVIDER=laravel_mail
# COMM_WHATSAPP_PROVIDER=open_source_webhook
# COMM_SMS_PROVIDER=open_source_webhook
# COMM_NOTIFICATION_PROVIDER=database
# COMM_EMAIL_FROM_NAME=Hayat Travel Solutions
# COMM_EMAIL_FROM_ADDRESS=hello@example.com
# COMM_WHATSAPP_WEBHOOK_BASE_URL=
# COMM_WHATSAPP_WEBHOOK_TOKEN=
# COMM_WHATSAPP_TIMEOUT_SECONDS=10
# COMM_SMS_WEBHOOK_BASE_URL=
# COMM_SMS_WEBHOOK_TOKEN=
# COMM_SMS_TIMEOUT_SECONDS=10

# Support desk SLA policy (hours)
# SUPPORT_SLA_LOW_FIRST_RESPONSE_HOURS=24
# SUPPORT_SLA_LOW_RESOLUTION_HOURS=72
# SUPPORT_SLA_MEDIUM_FIRST_RESPONSE_HOURS=8
# SUPPORT_SLA_MEDIUM_RESOLUTION_HOURS=24
# SUPPORT_SLA_HIGH_FIRST_RESPONSE_HOURS=2
# SUPPORT_SLA_HIGH_RESOLUTION_HOURS=8
# SUPPORT_SLA_URGENT_FIRST_RESPONSE_HOURS=1
# SUPPORT_SLA_URGENT_RESOLUTION_HOURS=4

# Compliance & Safety
# BACKUP_DISK=local
# COMPLIANCE_APPROVAL_TTL_HOURS=72

# Document scanning / upload security
# local: DOCUMENT_SCAN_MODE=stub (or disabled)
# testing: DOCUMENT_SCAN_MODE=stub
# staging: DOCUMENT_SCAN_MODE=real
# production: DOCUMENT_SCAN_MODE=real (required unless policy overridden)
DOCUMENT_SCAN_MODE=stub
DOCUMENT_SCAN_PROVIDER=stub
DOCUMENT_SCAN_REQUIRE_REAL_IN_PROD=true
# Stub result controls (deterministic testing/dev)
DOCUMENT_SCAN_STUB_STATUS=clean
DOCUMENT_SCAN_STUB_MESSAGE=Stub scan result
# Optional comma-separated sequence for controlled local scenarios (reserved for future use)
# DOCUMENT_SCAN_STUB_SEQUENCE=clean,infected,failed
# Scanner payload size cap
DOCUMENT_SCAN_MAX_FILE_SIZE_BYTES=20971520
# Upload pre-scan limits
DOCUMENT_UPLOAD_MAX_FILE_SIZE_BYTES=10485760
# ClamAV (real mode)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=5

VITE_APP_NAME="${APP_NAME}"
